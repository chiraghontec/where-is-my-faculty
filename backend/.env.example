# Server
PORT=3001
NODE_ENV=development

# Database
DATABASE_URL="postgresql://wimf:wimf_dev_password@localhost:5432/faculty_db"

# Microsoft Graph / Azure AD
# Register an app at https://portal.azure.com → Azure Active Directory → App Registrations
# Grant Application permissions: Calendars.Read, User.Read.All, MailboxSettings.Read
AZURE_TENANT_ID="your-tenant-id"
AZURE_CLIENT_ID="your-app-client-id"
AZURE_CLIENT_SECRET="your-client-secret"

# JWT Auth
JWT_SECRET="change-this-to-a-strong-256-bit-secret"
JWT_EXPIRY="24h"

# Calendar Sync
SYNC_INTERVAL_MINUTES=5
SYNC_CONCURRENCY=10
SYNC_LOOKAHEAD_DAYS=7

# CORS
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"
